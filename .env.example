# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API).

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon / publishable). Pode ficar exposta no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role). USADA SÓ no script `npm run create-admin`.
# Nunca coloque no navegador, nunca commite, nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site (usado em sitemap, SEO e links). Em produção: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
